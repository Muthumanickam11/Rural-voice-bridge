# Rural Voice Bridge - Backend Environment Configuration
# Copy this file to .env and fill in your API keys

# ──────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────────────
# AI PROVIDER KEYS (Get one or both — backend auto-selects)
# ──────────────────────────────────────────────────

# Groq (Free tier available): https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Free tier available): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────────
# OPTIONAL OVERRIDES
# ──────────────────────────────────────────────────
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GEMINI_MODEL_TEXT=gemini-2.5-flash
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=900
# RATE_LIMIT_PER_MINUTE=60
# MAX_AUDIO_SECONDS=60
# MAX_AUDIO_MB=5
